.tool-root { padding: 8px; }
.grow { flex-grow: 1; }
.title { font-size: 17px; -unity-font-style: bold; margin-bottom: 8px; }
.section-title { -unity-font-style: bold; margin-top: 14px; margin-bottom: 6px; }
.description { white-space: normal; margin-bottom: 8px; }
.toolbar-row { flex-direction: row; flex-wrap: wrap; margin-bottom: 8px; }
.report-list { flex-grow: 1; min-height: 150px; }
.report-item { flex-direction: row; align-items: center; padding-left: 4px; padding-right: 4px; }
.report-text { flex-grow: 1; flex-shrink: 1; white-space: normal; }
.report-button { width: 54px; margin-left: 6px; }
